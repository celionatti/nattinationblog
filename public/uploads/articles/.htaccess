# Security configuration for upload directory
# Generated by FileUploader

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .pht

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|pht|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
</IfModule>
